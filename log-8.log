      } else {
        logger.warn(
            "Cannot acquire update lock, aborting updateDelta operation of fetchAndStoreDelta");
      }

      // There is a diff in number of instances for some reason
      if (!reconcileHashCode.equals(delta.getAppsHashCode())) {
