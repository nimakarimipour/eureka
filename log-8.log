    // remote region fetch
    Runnable remoteRegionFetchTask =
        new Runnable() {
          @Override
          public void run() {
            try {
              if (fetchRegistry()) {
                readyForServingData = true;
              } else {
                logger.warn(
                    "Failed to fetch remote registry. This means this eureka server is not "
                        + "ready for serving traffic.");
