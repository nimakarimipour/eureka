        iter.hasNext(); ) {

      Map<String, Lease<InstanceInfo>> leaseMap = iter.next().getValue();
      if (leaseMap != null) {
        Lease<InstanceInfo> lease = leaseMap.get(id);

        if (lease == null || (isLeaseExpirationEnabled() && lease.isExpired())) {
